{
  "name": "Tyler's NFL APP",
  "short_name": "NFL APP",
  "description": "NFL scores, standings, stats, picks, fantasy tools and a football Game Room.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141a16",
  "theme_color": "#0f1512",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Game Room", "url": "./#games", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Scores", "url": "./#scores", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ]
}
